# Application
APP_NAME=Buddy
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Optional file logging (relative to project root)
# LOG_FILE=logs/buddy.log

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# LLM — Groq (https://console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_MAX_TOKENS_FUNDAMENTAL=640
LLM_MAX_TOKENS_TECHNICAL=768
LLM_MAX_TOKENS_SENTIMENT=640
LLM_MAX_TOKENS_MASTER=1024
LLM_MAX_TOKENS_COMPARISON=1024
LLM_MAX_TOKENS_PORTFOLIO=768
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=30.0
LLM_STRUCTURED_OUTPUT_RETRY_BOOST=256
LLM_STRUCTURED_OUTPUT_RETRY_MAX_TOKENS=1280

# Data providers
YAHOO_FINANCE_TIMEOUT=30
YAHOO_RETRY_MAX_ATTEMPTS=3
YAHOO_RETRY_BASE_DELAY_SECONDS=0.5
YAHOO_RETRY_MAX_DELAY_SECONDS=8.0
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_RETRY_MAX_ATTEMPTS=2
WEB_SEARCH_RETRY_BASE_DELAY_SECONDS=1.0
WEB_SEARCH_RETRY_MAX_DELAY_SECONDS=15.0
WEB_SEARCH_RATE_LIMIT_CACHE_SECONDS=120

# Cache (SQLite MVP)
CACHE_ENABLED=true
CACHE_DB_PATH=data/cache.db
CACHE_TTL_QUOTES_SECONDS=300
CACHE_TTL_HISTORICAL_SECONDS=3600
CACHE_TTL_FINANCIALS_SECONDS=86400
CACHE_TTL_SEARCH_SECONDS=1800

# Scoring weights (must sum to 1.0)
WEIGHT_FUNDAMENTAL=0.40
WEIGHT_TECHNICAL=0.35
WEIGHT_SENTIMENT=0.15
WEIGHT_RISK=0.10

# Rating thresholds (0–100)
RATING_STRONG_BUY_MIN=80
RATING_BUY_MIN=65
RATING_HOLD_MIN=45

# Streamlit frontend
API_BASE_URL=http://localhost:8000/api
